{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Bundler",

    "lib": ["ES2020", "DOM"],
    "types": [],

    "strict": true,
    "skipLibCheck": true,

    "sourceMap": true,

    "declaration": false,
    "declarationMap": false,

    "verbatimModuleSyntax": false,
    "isolatedModules": false
  },
  "include": ["src"]
}