# Copie este arquivo para .env.local (ou configure as mesmas chaves no
# dashboard do Vercel, em Settings > Environment Variables) e preencha
# com os valores reais. Nenhum destes arquivos .env* é versionado no Git.

# Supabase — URL do projeto e anon key (públicas por design, protegidas
# por Row Level Security, mas mantidas fora do código-fonte por boa prática).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Google Gemini — usada em api/flashcards/scanner.js para gerar flashcards com IA.
GEMINI_API_KEY=

# Opcionais: usadas apenas para estimar o custo em USD de cada geração de cards.
GEMINI_SCANNER_INPUT_COST_PER_1M=
GEMINI_SCANNER_OUTPUT_COST_PER_1M=
